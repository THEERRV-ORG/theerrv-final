# Firebase web config for the contact form (Firestore).
# Copy this file to `.env.local` and fill in your project's values from:
#   Firebase console → Project settings → General → Your apps → SDK setup & config
#
# These VITE_-prefixed vars are bundled into the client, which is expected for
# Firebase web config — they are not secrets. Data is protected by Firestore
# Security Rules (see src/lib/firebase.js), not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
