# Where the contact form sends submissions. Defaults to production Ares
# (https://ares.theerrv.com/api/contact) when unset. To test against a local
# Ares, copy this file to `.env.local` and point it at that instance — and add
# this site's dev origin (http://localhost:5173) to Ares's CONTACT_ALLOWED_ORIGINS.
VITE_CONTACT_ENDPOINT=
